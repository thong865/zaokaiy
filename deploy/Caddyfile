# Traffic flow: browser → Cloudflare (TLS) → cloudflared tunnel → caddy:80 (plain HTTP).
# Cloudflare terminates HTTPS, so Caddy serves HTTP only and needs no certificates or open ports.
{
	auto_https off
	servers {
		# cloudflared reaches Caddy over the private Docker network; trust its X-Forwarded-* headers
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	# Rust API, incl. webhooks (/api/webhooks/*) and uploads
	handle /api/* {
		reverse_proxy api:8080
	}
	# Uploaded media (local storage driver)
	handle /media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy api:8080
	}
	# Everything else: Nuxt SSR
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
