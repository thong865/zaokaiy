DATABASE_URL=postgres://zaokaiy:zaokaiy@localhost:5432/zaokaiy
BIND_ADDR=0.0.0.0:8080
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=168
CORS_ORIGINS=http://localhost:3000
# AI via OpenRouter (https://openrouter.ai/keys). Leave empty to run AI features in offline template mode
OPENROUTER_API_KEY=
# Any OpenRouter model id with tool calling; fallbacks are tried in order if the primary fails
AI_MODEL=google/gemini-3.8-flash
AI_FALLBACK_MODELS=deepseek/deepseek-v4.1-flash
# Optional: app attribution on openrouter.ai
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=zaokaiy
# Retries on 429/5xx (waits Retry-After or 1s, 2s, 4s); if still rate limited, answer with offline templates
AI_MAX_RETRIES=2
AI_RETRY_MAX_WAIT_SECS=10
AI_OFFLINE_ON_BUSY=true
RUST_LOG=info,zaokaiy_api=debug
# Optional: any OpenAI-compatible endpoint (e.g. a self-hosted vLLM/Ollama for open-source models)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Media storage ---
# local = files in MEDIA_DIR served at /media ; s3 = S3-compatible (AWS, MinIO, R2)
MEDIA_DRIVER=local
MEDIA_DIR=./media
# Public base URL of stored files (for s3: bucket/CDN URL, e.g. http://localhost:9000/zaokaiy-media)
MEDIA_PUBLIC_URL=http://localhost:8080/media
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=200
# Reject images smaller than this on the shortest side (0 = no check). 1200+ is recommended to sellers.
MEDIA_MIN_IMAGE_EDGE=500
# Corporate KYC: private files (never served) + encryption key (openssl rand -base64 32).
# Without a key a development key is derived from JWT_SECRET — always set one in production.
PRIVATE_DIR=./private
KYC_ENCRYPTION_KEY=
KYB_REQUIRED_TO_PUBLISH=true
KYB_REVIEW_MONTHS=12
S3_ENDPOINT=
S3_BUCKET=zaokaiy-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Moderation ---
# required = sellers' products wait for admin approval before going live; off = publish immediately
PRODUCT_REVIEW=required
# Editing name/description/category/photos of a live product sends it back for review
REVIEW_ON_EDIT=true
# Comma-separated emails promoted to platform admin (access to /admin)
ADMIN_EMAILS=admin@demo.dev

# --- Social commerce (comment → order) ---
# Public URL of the web app, used in checkout links sent to customers
PUBLIC_WEB_URL=http://localhost:3000
# Meta (Facebook Page comments + Messenger, WhatsApp Cloud API) webhooks: /api/webhooks/meta
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_URL=https://graph.facebook.com/v21.0
# TikTok webhooks: /api/webhooks/tiktok (signature check)
TIKTOK_CLIENT_SECRET=

# --- Social login (Google, Facebook, WhatsApp) ---
# Public URL of this API as browsers reach it; OAuth callbacks are <PUBLIC_API_URL>/auth/oauth/{google|facebook}/callback
PUBLIC_API_URL=http://localhost:8080/api
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → your app → Facebook Login (can be the same app as social selling)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# WhatsApp Cloud API: platform number that sends login codes + an approved AUTHENTICATION template
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=zaokaiy_login
WHATSAPP_OTP_LANG=en_US
# Optional: template language used when the site is in Lao (only if you created a Lao version)
WHATSAPP_OTP_LANG_LO=
OTP_RESEND_SECONDS=60
# Local testing only: return the WhatsApp code in the API response (enables WhatsApp login without Meta)
OTP_DEV_ECHO=false

# Cloudflare Turnstile human check on log in / sign up / WhatsApp codes (off while either is empty).
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Module: COD risk (report customers who refuse COD parcels; admin sets risk levels) ---
# false = module off: routes 404, no checkout check, UI entries hidden
COD_RISK_ENABLED=true
# Secret key for customer ids on the ledger (HMAC of the phone). Set once in production and never change it.
COD_RISK_PEPPER=
# Checkout refuses cash on delivery at/above this level: low | medium | high | blocked | off
COD_RISK_BLOCK_COD_AT=blocked
# Days after a parcel comes back during which the seller can report it
COD_RISK_REPORT_WINDOW_DAYS=30
# Blockchain anchoring: none (local hash chain only) | webhook (POST Merkle roots to a chain gateway)
COD_RISK_ANCHOR=none
COD_RISK_ANCHOR_URL=
COD_RISK_ANCHOR_SECRET=
COD_RISK_ANCHOR_EVERY_SECS=300
COD_RISK_LEDGER_NAME=zaokaiy-cod-risk

# --- Module: image suggestions (suggest existing photos while a seller types a product name) ---
# false = module off: no suggestions, stock-photo admin page hidden
IMAGE_SUGGEST_ENABLED=true
# Also suggest live photos of shops that opted in to sharing (Media library → switch)
IMAGE_SUGGEST_SHARED=true

# Desktop POS terminals (offline sync). false = module off
POS_SYNC_ENABLED=true

# Super app cores — run all in one process (default), or a subset here and proxy the rest:
#   ZK_CORES=platform,commerce,restaurant,insurance,finance
#   ZK_REMOTE_VEHICLE=http://vehicle-host:8080
ZK_CORES=all

# --- Promotions & loyalty points (module promo) ---------------------------------------------
# Campaigns (sign-up via Facebook/WhatsApp/Google/email, first order, promo codes) and per-shop points.
PROMO_ENABLED=true
# How often sign-up coupons are handed out, in seconds.
PROMO_JOB_SECS=60
