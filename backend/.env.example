DATABASE_URL=postgres://zaokaiy:zaokaiy@localhost:5432/zaokaiy
BIND_ADDR=0.0.0.0:8080
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=168
CORS_ORIGINS=http://localhost:3000
# Leave empty to run AI features in offline template mode
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
RUST_LOG=info,zaokaiy_api=debug
# Optional: override for proxies / gateways
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Media storage ---
# local = files in MEDIA_DIR served at /media ; s3 = S3-compatible (AWS, MinIO, R2)
MEDIA_DRIVER=local
MEDIA_DIR=./media
# Public base URL of stored files (for s3: bucket/CDN URL, e.g. http://localhost:9000/zaokaiy-media)
MEDIA_PUBLIC_URL=http://localhost:8080/media
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=200
S3_ENDPOINT=
S3_BUCKET=zaokaiy-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Moderation ---
# required = sellers' products wait for admin approval before going live; off = publish immediately
PRODUCT_REVIEW=required
# Editing name/description/category/photos of a live product sends it back for review
REVIEW_ON_EDIT=true
# Comma-separated emails promoted to platform admin (access to /admin)
ADMIN_EMAILS=admin@demo.dev

# --- Social commerce (comment → order) ---
# Public URL of the web app, used in checkout links sent to customers
PUBLIC_WEB_URL=http://localhost:3000
# Meta (Facebook Page comments + Messenger, WhatsApp Cloud API) webhooks: /api/webhooks/meta
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_URL=https://graph.facebook.com/v21.0
# TikTok webhooks: /api/webhooks/tiktok (signature check)
TIKTOK_CLIENT_SECRET=
