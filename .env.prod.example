# Production settings for docker-compose.prod.yml — copy to .env.prod and fill in.
# Generate secrets with:  openssl rand -hex 32

# Your domain (DNS A record → the VPS IP). No https://, no trailing slash.
DOMAIN=shop.example.com

# Database password — use hex (letters/digits only) so it is safe inside the connection URL
POSTGRES_PASSWORD=
# Long random string for login tokens
JWT_SECRET=
JWT_TTL_HOURS=168

# Emails that become platform admins (access to /admin), comma-separated
ADMIN_EMAILS=you@example.com
# required = new products wait for admin approval; off = publish immediately
PRODUCT_REVIEW=required
REVIEW_ON_EDIT=true

# Media: "local" keeps uploads in a Docker volume on the VPS.
# For S3-compatible storage (Hostinger Object Storage, Cloudflare R2, AWS, MinIO) set MEDIA_DRIVER=s3
# and point MEDIA_PUBLIC_URL at the bucket/CDN URL.
MEDIA_DRIVER=local
# MEDIA_PUBLIC_URL=https://cdn.example.com/zaokaiy-media
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=200
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI features (leave empty for offline template mode)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Social selling (comment → order). Webhook URLs:
#   https://DOMAIN/api/webhooks/meta     (Facebook, Messenger, WhatsApp)
#   https://DOMAIN/api/webhooks/tiktok
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_URL=https://graph.facebook.com/v21.0
TIKTOK_CLIENT_SECRET=

RUST_LOG=info
