# Production settings for docker-compose.prod.yml — copy to .env.prod and fill in.
# Generate secrets with:  openssl rand -hex 32

# Your domain (routed through the Cloudflare Tunnel). No https://, no trailing slash.
DOMAIN=shop.example.com

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install command, the long eyJ... string)
TUNNEL_TOKEN=

# Database password — use hex (letters/digits only) so it is safe inside the connection URL
POSTGRES_PASSWORD=
# Long random string for login tokens
JWT_SECRET=
JWT_TTL_HOURS=168

# Emails that become platform admins (access to /admin), comma-separated
ADMIN_EMAILS=you@example.com
# required = new products wait for admin approval; off = publish immediately
PRODUCT_REVIEW=required
REVIEW_ON_EDIT=true

# Media: "local" keeps uploads in a Docker volume on the VPS.
# For S3-compatible storage (Hostinger Object Storage, Cloudflare R2, AWS, MinIO) set MEDIA_DRIVER=s3
# and point MEDIA_PUBLIC_URL at the bucket/CDN URL.
MEDIA_DRIVER=local
# MEDIA_PUBLIC_URL=https://cdn.example.com/zaokaiy-media
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=200
MEDIA_MIN_IMAGE_EDGE=500
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI via OpenRouter (https://openrouter.ai/keys). Leave empty to run AI features in offline template mode
OPENROUTER_API_KEY=
# Any OpenRouter model id with tool calling; fallbacks are tried in order if the primary fails
AI_MODEL=google/gemini-3.8-flash
AI_FALLBACK_MODELS=deepseek/deepseek-v4.1-flash
# Optional: app attribution on openrouter.ai
OPENROUTER_SITE_URL=https://your-domain
OPENROUTER_APP_NAME=zaokaiy
# Retries on 429/5xx (waits Retry-After or 1s, 2s, 4s); if still rate limited, answer with offline templates
AI_MAX_RETRIES=2
AI_RETRY_MAX_WAIT_SECS=10
AI_OFFLINE_ON_BUSY=true

# Social selling (comment → order). Webhook URLs:
#   https://DOMAIN/api/webhooks/meta     (Facebook, Messenger, WhatsApp)
#   https://DOMAIN/api/webhooks/tiktok
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_URL=https://graph.facebook.com/v21.0
TIKTOK_CLIENT_SECRET=

# Social login — leave empty to hide a button. Setup steps: DEPLOY.md → "Social login".
#   Google/Facebook redirect URI: https://DOMAIN/api/auth/oauth/google/callback (…/facebook/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# WhatsApp login codes: Cloud API token + phone number id of the number that sends them,
# and the name/language of an approved AUTHENTICATION template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=zaokaiy_login
WHATSAPP_OTP_LANG=en_US
WHATSAPP_OTP_LANG_LO=

# Cloudflare Turnstile human check (log in / sign up / WhatsApp codes). DEPLOY.md → "Human check".
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

RUST_LOG=info

# --- Module: COD risk (report customers who refuse COD parcels; admin sets risk levels) ---
# false = module off: routes 404, no checkout check, UI entries hidden
COD_RISK_ENABLED=true
# Secret key for customer ids on the ledger (HMAC of the phone). Set once in production and never change it.
COD_RISK_PEPPER=   # openssl rand -base64 32
# Checkout refuses cash on delivery at/above this level: low | medium | high | blocked | off
COD_RISK_BLOCK_COD_AT=blocked
# Days after a parcel comes back during which the seller can report it
COD_RISK_REPORT_WINDOW_DAYS=30
# Blockchain anchoring: none (local hash chain only) | webhook (POST Merkle roots to a chain gateway)
COD_RISK_ANCHOR=none
COD_RISK_ANCHOR_URL=
COD_RISK_ANCHOR_SECRET=
COD_RISK_ANCHOR_EVERY_SECS=300
COD_RISK_LEDGER_NAME=zaokaiy-cod-risk

# --- Module: image suggestions (suggest existing photos while a seller types a product name) ---
# false = module off: no suggestions, stock-photo admin page hidden
IMAGE_SUGGEST_ENABLED=true
# Also suggest live photos of shops that opted in to sharing (Media library → switch)
IMAGE_SUGGEST_SHARED=true
